{
  "name": "agy-better-sidebar",
  "version": "2.0.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "description": "Antigravity IDE-style read-only side workbench, rich file previewer, and AI code reading companion plugin.",
  "scripts": {
    "build:workbench": "vite build --config vite.workbench.config.ts",
    "build:viewer": "vite build --config vite.viewer.config.ts",
    "build:server": "node scripts/build-server.mjs",
    "build": "npm run build:workbench && npm run build:viewer && npm run build:server",
    "deploy": "node scripts/deploy-plugin.mjs",
    "pack:release": "node scripts/pack-release.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.3.3",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.9.0",
    "@codemirror/lang-vue": "^0.1.3",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/language": "^6.11.0",
    "@codemirror/legacy-modes": "^6.5.1",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.38.1",
    "@lezer/highlight": "^1.2.1",
    "@modelcontextprotocol/ext-apps": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "dompurify": "^3.2.6",
    "js-yaml": "^4.1.0",
    "katex": "^0.16.22",
    "lucide-react": "^0.511.0",
    "marked": "^15.0.12",
    "mermaid": "^11.6.0",
    "papaparse": "^5.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/js-yaml": "^4.0.9",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.15.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "esbuild": "^0.25.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-singlefile": "^2.2.0"
  }
}
